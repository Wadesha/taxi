# ============================================================
#  出租车轨迹分析站 · .gitignore
#  原则：仓库只放「站点 + 样本」，全量原始数据本地保留但不推送
# ============================================================

# ---- 全量原始数据：本地保留，绝不进仓库 ----
# 北京 8911 个 txt / 深圳 24 个每小时 CSV / 无锡 31 个 zip
# 体积合计 ~3.1 GB，远超 GitHub 单文件 100MB、仓库 ~1GB 的推荐上限。
# 仅本地留存用于离线复算，推送时由本规则整体屏蔽。
raw/

# ---- WorkBuddy 本地配置与记忆（含隐私，绝不公开）----
.workbuddy/

# ---- 压缩包全局安全网（即便误放到仓库其它位置也不进）----
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# ---- Python 编译产物 ----
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 日志与临时 ----
*.log
*.tmp
*.bak

# ---- 本地预览 / 构建输出 ----
/site/
/dist/
